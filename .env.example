# 知微智能数学学习系统 — 环境变量示例（复制为 .env 后填写真实值）
# 注意：.env 含有密钥，禁止提交到版本库（已在 .gitignore / AGENTS.md 约定）。

# ── 运行时基础 ──
DEBUG=true
APP_NAME=知微智能数学学习系统
APP_VERSION=0.1.0

# ── 数据库 / 中间件（生产用 PostgreSQL；本地 SQLite 需显式配置）──
# POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/math_ai
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333

# ── 管理员账号（首次启动 / 迁移时用于内容审核登录）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ── 通用 AI 密钥（原 MathAgent / 答题链路，与本任务的 Content AI 解耦）──
DASHSCOPE_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Content AI Provider（Step 1.1-E2-A0）
# ═══════════════════════════════════════════════════════════════════
# 当前模式：mock（默认，无需 Key / 网络，确定性输出，用于验证 pipeline）。
#   - mock    ：MockContentAIProvider，结果标记 ai_provider='mock'，服务端禁止正式发布。
#   - deepseek：DeepSeekContentAIProvider（真实，OpenAI 兼容），填 DEEPSEEK_API_KEY 即可用。
#   - qwen    ：QwenContentAIProvider（当前为 stub，调用即返回 AI_PROVIDER_NOT_IMPLEMENTED）。
#   - auto    ：按配置自动选择（当前等价于 qwen stub）。
# 切换到真实 DeepSeek：把 CONTENT_AI_PROVIDER 设为 deepseek，并填写下面的
# DEEPSEEK_API_KEY，UI / API / DB / workflow 无需改动。
CONTENT_AI_PROVIDER=mock

# 真实 DeepSeek provider（OpenAI 兼容；填 Key 后即可真实分析，消耗 token）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=60
# 智能检测（AI 组卷蓝图）固定使用以上 DeepSeek 配置；缺少 Key 时
# 自动使用规则蓝图回退，不读取 QWEN_*、DASHSCOPE_API_KEY 或 LLM_MODEL。

# 真实 Qwen provider（Step 1.1-E2-A0 预留；当前 stub 未实现，留空即可）
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
