# 知微智能数学学习系统 — 环境变量示例（复制为 .env 后填写真实值）
# 注意：.env 含有密钥，禁止提交到版本库（已在 .gitignore / AGENTS.md 约定）。

# ── 运行时基础 ──
DEBUG=true
APP_ENV=development
APP_NAME=知微智能数学学习系统
APP_VERSION=0.1.0
LOG_LEVEL=INFO
JSON_LOGS=true
METRICS_ENABLED=true
# Web 端口暴露到非内部网络时必须设置，并同步配置 Prometheus 抓取凭据。
METRICS_BEARER_TOKEN=
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# ── 数据库 / 中间件（生产用 PostgreSQL；本地 SQLite 需显式配置）──
# POSTGRES_DSN=postgresql+asyncpg://user:password@localhost:5432/math_ai
# REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
VECTOR_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_SIZE=512
QUESTION_QDRANT_COLLECTION=math_questions_bge_zh_v1
MEMORY_QDRANT_COLLECTION=user_memories_bge_zh_v1
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=8
OUTBOX_POLL_SECONDS=5

# ── 管理员账号（首次启动 / 迁移时用于内容审核登录）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ── 主文本 LLM（MathAgent / 答题 / 解题链路）──
# 文本链路统一使用 LLM_API_KEY（优先）+ LLM_API_BASE + LLM_MODEL。
# 不填 LLM_API_KEY 时，自动兜底使用 DASHSCOPE_API_KEY（保持原千问行为，向后兼容）。
# 示例：切到 DeepSeek-V4-Flash（文本比千问便宜，视觉仍用千问）
# LLM_API_KEY=sk-xxxxxxxx
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max
LLM_MATH_MODEL=qwen-turbo
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# ── 视觉 LLM（图片 / 公式识别，qwen-vl-plus）──
# 视觉链路独立只读 DASHSCOPE_API_KEY，不会受上面 LLM_API_KEY 切换影响。
# 成本比对：qwen-vl-plus 输出 2 元/百万 token，低于 DeepSeek-V4-Flash-Vision 的
# 4.5~9 元/百万 token，故视觉后端保持千问、不随文本模型切换。
DASHSCOPE_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# Content AI Provider（Step 1.1-E2-A0）
# ═══════════════════════════════════════════════════════════════════
# 当前模式：mock（默认，无需 Key / 网络，确定性输出，用于验证 pipeline）。
#   - mock    ：MockContentAIProvider，结果标记 ai_provider='mock'，服务端禁止正式发布。
#   - deepseek：DeepSeekContentAIProvider（真实，OpenAI 兼容），填 DEEPSEEK_API_KEY 即可用。
#   - qwen    ：QwenContentAIProvider（当前为 stub，调用即返回 AI_PROVIDER_NOT_IMPLEMENTED）。
#   - auto    ：按配置自动选择（当前等价于 qwen stub）。
# 切换到真实 DeepSeek：把 CONTENT_AI_PROVIDER 设为 deepseek，并填写下面的
# DEEPSEEK_API_KEY，UI / API / DB / workflow 无需改动。
CONTENT_AI_PROVIDER=mock

# 真实 DeepSeek provider（OpenAI 兼容；填 Key 后即可真实分析，消耗 token）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_SECONDS=60
# 智能组卷（AI 蓝图）固定使用以上 DeepSeek 配置；缺少 Key 时
# 自动使用规则蓝图回退，不读取 QWEN_*、DASHSCOPE_API_KEY 或 LLM_MODEL。

# 真实 Qwen provider（Step 1.1-E2-A0 预留；当前 stub 未实现，留空即可）
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 模型质量受控在线评测（仅隔离的 *_eval / *_test PostgreSQL）──
EVAL_DATABASE_URL=
EVAL_INPUT_COST_PER_MILLION=
EVAL_OUTPUT_COST_PER_MILLION=
EVAL_MAX_COST_USD=2.00
