{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpandedGoldenCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "capability", "input", "expected_capability", "key_answer", "allowed_variants", "severe_errors", "dataset_version", "privacy"],
  "properties": {
    "case_id": {"type":"string","minLength":1},
    "capability": {"enum":["math_qa","image_question","formula_parsing","rag_retrieval","error_attribution","learning_recommendation","refusal"]},
    "input": {"type":"object"},
    "expected_capability": {"type":"string","minLength":1},
    "key_answer": {},
    "allowed_variants": {"type":"string","minLength":1},
    "severe_errors": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "dataset_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "privacy": {"type":"object","required":["source","redacted"],"properties":{"source":{"enum":["synthetic","public_license_reviewed"]},"redacted":{"const":true}},"additionalProperties":false}
  }
}
